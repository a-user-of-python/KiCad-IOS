--- a/kicad/CMakeLists.txt
+++ b/kicad/CMakeLists.txt
@@ -144,6 +144,15 @@
     target_link_options( kicad PRIVATE "-Wl,-e,_qt_main_wrapper" )
 endif()
 
+# [KiCad-IOS port] Modified 2026-11-06 for iOS: mark the manager
+# executable so kicad.cpp compiles its iOS-only startup block (Qt
+# resource registration plus pre-QApplication environment defaults;
+# see the matching KICAD_IOS_PORT block in kicad.cpp for the device
+# crash that motivates it).
+if( CMAKE_SYSTEM_NAME STREQUAL "iOS" )
+    target_compile_definitions( kicad PRIVATE KICAD_IOS_PORT )
+endif()
+
 add_executable( kicad-cli WIN32
