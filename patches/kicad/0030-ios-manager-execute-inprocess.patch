 int KICAD_MANAGER_CONTROL::ExploreProject( const TOOL_EVENT& aEvent )
 {
+#ifdef KICAD_IOS_PORT
+    // [KiCad-IOS port] Modified 2026-11-07 for iOS (launch fix round 9,
+    // KiCad-Spike-v11): LaunchExternal() hands the folder to the host
+    // file explorer; iOS offers an app no way to open a folder in
+    // one, so on device the action silently did nothing. The bundle
+    // enables file sharing, so say where the files actually are.
+    DisplayInfoMessage( m_frame,
+                        wxString::Format( _( "This project's folder is:\n\n%s\n\n"
+                                             "Projects stored in the app's Documents "
+                                             "folder can be browsed in the Files app "
+                                             "under \"KiCad (spike)\"." ),
+                                          Prj().GetProjectPath() ),
+                        wxEmptyString );
+    return 0;
+#else
     // Open project directory in host OS's file explorer
     LaunchExternal( Prj().GetProjectPath() );
     return 0;
+#endif
 }
 
