--- a/libs/kiplatform/CMakeLists.txt
+++ b/libs/kiplatform/CMakeLists.txt
@@ -32,7 +32,12 @@
 
 
 # Add OS-specific files and definitions
-if( APPLE )
+# [KiCad-IOS port] On iOS the os/apple sources do not apply: they are
+# written against AppKit/macOS frameworks that do not exist there. The
+# iOS build skips them for now; the link catalogue will show exactly
+# which KIPLATFORM OS functions the editors actually reference, and
+# those get UIKit/POSIX implementations under os/ios/.
+if( APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS" )
     list( APPEND PLATFORM_SRCS
         os/apple/app.mm
         os/apple/drivers.mm
