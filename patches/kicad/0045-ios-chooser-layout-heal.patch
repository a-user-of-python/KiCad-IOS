+void PANEL_SYMBOL_CHOOSER::onLayoutHealTimer( wxTimerEvent& aEvent )
+{
+    // [KiCad-IOS port] Added 2026-11-10 for iOS (round 19, Job U, KiCad
+    // patch 0045): post-settle layout heal + preview repaint.
+    //
+    // Visibility half: this fires inside the host's event loop (the
+    // chooser dialog's true-modal loop, or the modeless frame's loop)
+    // when the host is shown at its final size -- the first moment
+    // every earlier sash restore (FinishSetup, DIALOG_SHIM's
+    // LoadControlState, and the grow-only __geometry restore in
+    // DIALOG_SHIM::Show) has already run. Re-validate the sashes
+    // against the live splitter sizes and write the healed values
+    // back into the settings struct, so the destructor's unconditional
+    // save re-banks the heal rather than any poisoned value an
+    // earlier restore planted.
+    //
+    // Paint half: a preview's first paint is a one-shot ForceRefresh
+    // that silently no-ops while its canvas is zero-sized or not yet
+    // shown on screen, and nothing re-asks afterwards (the footprint
+    // widget additionally caches the displayed LIB_ID, suppressing a
+    // retry of the same footprint). A selection made before the
+    // layout settled -- or into a pane an earlier restore collapsed
+    // -- therefore stays blank forever. Re-display both previews
+    // here, at real sizes: DisplaySymbol refits and repaints, and the
+    // footprint is re-displayed through the preview panel directly,
+    // bypassing the widget's already-displayed cache.
+    wxLogTrace( wxT( "KICAD_IOS" ), wxT( "jobu-chooser-layout-heal" ) );
+
+    if( EESCHEMA_SETTINGS* cfg = dynamic_cast<EESCHEMA_SETTINGS*>( Kiface().KifaceSettings() ) )
+    {
+        EESCHEMA_SETTINGS::PANEL_SYM_CHOOSER& panelCfg = cfg->m_SymChooserPanel;
+
+        auto healSash =
+                [&]( wxSplitterWindow* aSplitter, int& aStored, bool aHorizontal )
+                {
+                    if( !aSplitter->IsSplit() )
+                        return;
+
+                    wxSize live = aSplitter->GetSize();
+                    int    extent = aHorizontal ? live.x : live.y;
+
+                    if( extent < 100 )
+                        return;
+
+                    int minPane = aSplitter->GetMinimumPaneSize();
+                    int lo = wxMax( minPane, extent * 15 / 100 );
+                    int hi = extent * ( aHorizontal ? 65 : 75 ) / 100;
+                    int sash = aSplitter->GetSashPosition();
+                    int healed = wxMax( lo, wxMin( sash, wxMax( lo, hi ) ) );
+
+                    if( healed != sash )
+                        aSplitter->SetSashPosition( healed );
+
+                    aStored = aSplitter->GetSashPosition();
+                };
+
+        healSash( m_hsplitter, panelCfg.sash_pos_h, true );
+
+        if( m_vsplitter )
+            healSash( m_vsplitter, panelCfg.sash_pos_v, false );
+    }
+
+    LIB_TREE_NODE* node = m_tree ? m_tree->GetCurrentTreeNode() : nullptr;
+
+    if( node && node->m_LibId.IsValid() )
+    {
+        m_symbol_preview->DisplaySymbol( node->m_LibId, node->m_Unit );
+
+        if( m_fp_preview && m_fp_preview->IsInitialized() )
+        {
+            wxString fpName = !m_fp_override.IsEmpty() ? m_fp_override
+                                                       : node->m_Footprint;
+
+            if( fpName.IsEmpty() )
+            {
+                // No default footprint on the tree node: the normal
+                // path re-reads the symbol's field, and the status
+                // text it sets for the empty case is the correct end
+                // state there.
+                showFootprintFor( node->m_LibId );
+            }
+            else
+            {
+                LIB_ID fpId;
+
+                if( fpId.Parse( fpName ) == -1 && fpId.IsValid()
+                    && m_fp_preview->GetPreviewPanel() )
+                {
+                    if( m_fp_preview->GetPreviewPanel()->DisplayFootprint( fpId ) )
+                        m_fp_preview->ClearStatus();
+                    else
+                        m_fp_preview->SetStatusText( _( "Footprint not found." ) );
+                }
+                else
+                {
+                    showFootprint( fpName );
+                }
+            }
+        }
+    }
+    else
+    {
+        if( m_symbol_preview && m_symbol_preview->GetCanvas() )
+            m_symbol_preview->GetCanvas()->ForceRefresh();
+
+        if( m_fp_preview && m_fp_preview->IsInitialized() )
+            m_fp_preview->RefreshAll();
+    }
+}
