+            m_CurrFootprint = static_cast<FOOTPRINT_PREVIEW_PANEL*>(
+                    m_preview_ctrl->GetPreviewPanel() )->GetCurrentFootprint();
+        }
+        else
+        {
+            m_preview_ctrl->RefreshAll();
+        }
+    }
+}
