 {
+#ifdef KICAD_IOS_PORT
+    // [KiCad-IOS port] Added 2026-11-07 for iOS (launch fix round 13,
+    // KiCad-Spike-v15): iOS has no OpenGL, so this port's editor
+    // canvas is the Cairo software canvas -- settled when the port
+    // was designed. Upstream's persisted graphics.canvas_type
+    // defaults to GAL_TYPE_OPENGL, so every editor resolved to GL,
+    // attempted it, showed "Could not use OpenGL, falling back to
+    // software rendering" and only then fell back (v14 device
+    // report). Return the software canvas here, at the one point
+    // every editor frame resolves its canvas type through, so the
+    // GL attempt -- and its dialog -- never happen: not on first
+    // run, where the stored default is OpenGL, and not with a
+    // configuration carried over from an earlier build that still
+    // stores OpenGL.
+    return EDA_DRAW_PANEL_GAL::GAL_TYPE_CAIRO;
+#endif
+
 #ifdef __WXMAC__
