@@ -101,7 +108,43 @@
 
 void KIPLATFORM::UI::ReparentModal( wxNonOwnedWindow* aWindow )
 {
-    // macOS child-window ordering only; not needed under Qt
+    // [KiCad-IOS port, patch 0046] Not a no-op under Qt.  wxQt
+    // constructs a dialog's QDialog as a Qt child of its parent
+    // frame's widget (wxQtEventSignalHandler passes the parent's
+    // GetHandle() to the QWidget constructor).  ShowQuasiModal()
+    // disables that parent (WINDOW_DISABLER on the optimal parent)
+    // before showing the dialog, and Qt propagates a widget's
+    // disabled state to all of its descendants -- child dialogs
+    // included -- so a quasi-modal dialog renders with the disabled
+    // palette and refuses input for its whole session (on device:
+    // Board Setup opened fully painted but grey and dead).  On the
+    // other toolkits a dialog's native window is independent of its
+    // parent's enabled state, and true-modal QDialog::exec()
+    // sessions are managed by Qt's own modal machinery, which is
+    // why only the quasi-modal path is affected.
+    //
+    // Detach the dialog from its Qt parent -- the wx parent chain,
+    // which owns lifetime and geometry, is untouched -- so the
+    // dialog stays enabled in front of the disabled frame.  Called
+    // by ShowQuasiModal() after the disabler is created and before
+    // Show(true), so the widget is still hidden and window flags
+    // are re-applied after the reparent (setParent resets them).
+    if( !aWindow )
+        return;
+
+    QWidget* widget = static_cast<QWidget*>( aWindow->GetHandle() );
+
+    if( widget && widget->parentWidget() )
+    {
+        const Qt::WindowFlags flags = widget->windowFlags();
+
+        widget->setParent( nullptr );
+        widget->setWindowFlags( flags );
+
+        wxLogTrace( wxT( "jobv-modal-detach" ),
+                    wxT( "ReparentModal: detached quasi-modal dialog "
+                         "from its Qt parent widget" ) );
+    }
 }
 
 
