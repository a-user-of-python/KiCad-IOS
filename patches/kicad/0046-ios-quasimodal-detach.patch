--- a/libs/kiplatform/port/wxqt/ui.cpp
+++ b/libs/kiplatform/port/wxqt/ui.cpp
@@ -29,7 +29,11 @@
  * work around native-toolkit behaviour on macOS/GTK (child-window
  * ordering, cmd-key collisions, cell-layout hacks, Wayland pointer
  * confinement, overlay scrolling, IME fixups) are no-ops here, exactly
- * as the GTK port no-ops the macOS ones and vice versa.
+ * as the GTK port no-ops the macOS ones and vice versa.  The one
+ * exception is ReparentModal, which must undo a real Qt behaviour
+ * (enabled-state propagation from a disabled parent widget into its
+ * child dialogs) that has no equivalent on the other toolkits; see
+ * KiCad patch 0046 and wx patch 0028.
  */
 
 #include <kiplatform/ui.h>
@@ -42,6 +46,8 @@
 #include <wx/utils.h>
 #include <wx/window.h>
 
+#include <wx/qt/window.h>
+
 
 bool KIPLATFORM::UI::IsDarkTheme()
 {
@@ -101,7 +107,24 @@
 
 void KIPLATFORM::UI::ReparentModal( wxNonOwnedWindow* aWindow )
 {
-    // macOS child-window ordering only; not needed under Qt
+    // [KiCad-IOS port, patch 0046] Not a no-op under Qt.
+    // ShowQuasiModal() disables the dialog's parent frame
+    // (WINDOW_DISABLER on the optimal parent) before showing the
+    // dialog, and wxQt constructs the dialog's QDialog as a Qt
+    // child of that frame's widget, so Qt's disabled-state
+    // propagation greys the dialog and refuses its input for the
+    // whole modal session (on device: Board Setup opened fully
+    // painted but disabled).  True-modal dialogs are unaffected:
+    // wxQt's ShowModal goes through QDialog::exec(), whose own
+    // modal machinery manages enablement, and the parent is
+    // never disabled on that path.  Detach the dialog from its
+    // Qt parent (wx patch 0028); the wx parent chain, which
+    // owns lifetime and geometry, is untouched, and the frame
+    // stays disabled, preserving the quasi-modal contract.
+    // ShowQuasiModal calls this after creating the disabler and
+    // before Show(true), while the dialog is still hidden.
+    if( aWindow )
+        wxQtDetachFromQtParent( aWindow );
 }
 
 
