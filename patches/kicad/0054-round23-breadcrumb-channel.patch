 void PATHS::getUserDocumentPath( wxFileName& aPath )
@@ -145,6 +152,33 @@
 }
 
 
+void PATHS::IosBreadcrumb( const char* aStage )
+{
+#ifdef KICAD_IOS_PORT
+    // [KiCad-IOS port] Round 23: see the declaration in paths.h.
+    // Deliberately NOT routed through wxLog: the port's trace mask
+    // is never enabled at runtime and the default log target is
+    // stderr, which cannot be retrieved from a sideloaded app after
+    // a crash. The file sits at the root of the app's Documents
+    // folder (Files -> On My iPad -> KiCad ->
+    // kicad-ios-breadcrumb.log); file sharing is enabled in the
+    // bundle by scripts/package_ios.py. Open/write/flush/fsync/
+    // close on EVERY call: a buffered line in an open handle would
+    // die with the process, a closed line does not.
+    const wxString path = KIPLATFORM::ENV::GetDocumentsPath()
+                          + wxS( "/kicad-ios-breadcrumb.log" );
+
+    if( FILE* f = wxFopen( path, wxS( "a" ) ) )
+    {
+        std::fprintf( f, "%lld %s\n", (long long) std::time( nullptr ), aStage );
+        std::fflush( f );
+        fsync( fileno( f ) );
+        std::fclose( f );
+    }
+#endif
+}
+
