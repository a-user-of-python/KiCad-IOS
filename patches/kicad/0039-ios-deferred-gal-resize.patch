 void EDA_DRAW_PANEL_GAL::onSize( wxSizeEvent& aEvent )
 {
+#ifdef KICAD_IOS_PORT
+    // [KiCad-IOS port] Modified 2026-11-09 for iOS (round 16, KiCad-V1):
+    // defer the GAL resize until the size settles. A window resize on
+    // this port arrives as a burst of size events -- the floating
+    // bar's un-maximise at drag start, every step of the
+    // minimize/restore geometry animation, Stage Manager and
+    // rotation changes -- and the resize body below
+    // (performSizeUpdate()) is the most expensive handler in the
+    // canvas: for the Cairo GAL it frees and reallocates both
+    // full-screen buffers, resizes and invalidates the compositor,
+    // and marks both view targets dirty, so the next paint is a full
+    // scene redraw plus a full-screen pixel swizzle and blit. Paying
+    // that per event, synchronously, at event rate is what made
+    // window movement feel "quite laggy": each step cost more than a
+    // frame, so the motion fell further behind with every event. On
+    // iOS the event therefore only (re)arms a 50 ms one-shot timer;
+    // the resize runs once, at the settled size, with the full
+    // redraw -- the final image is identical, only the intermediate
+    // sizes nobody could see are skipped. performSizeUpdate() reads
+    // the CURRENT client size when it runs, so no event payload has
+    // to be carried across the deferral.
+    wxLogTrace( traceDrawPanel, wxS( "deferred GAL resize" ) );
+    m_sizeTimer.StartOnce( 50 );
+#else
+    performSizeUpdate();
+#endif
+}
+
+
+void EDA_DRAW_PANEL_GAL::onSizeTimer( wxTimerEvent& aEvent )
+{
+    performSizeUpdate();
+}
+
+
+void EDA_DRAW_PANEL_GAL::performSizeUpdate()
+{
     // If we get a second wx update call before the first finishes, don't crash
     if( m_gal->IsContextLocked() )
         return;
