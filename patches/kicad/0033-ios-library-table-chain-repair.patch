+#ifdef KICAD_IOS_PORT
+// [KiCad-IOS port] Added 2026-11-07 for iOS (launch fix round 10,
+// KiCad-Spike-v12): detect-and-repair for global library tables
+// inherited from earlier builds of this port.
+//
+// The start wizard's USE_DEFAULTS flow writes each user global
+// table with a single chained row (nickname "KiCad") whose URI is
+// the ABSOLUTE stock table path as computed at that moment
+// (CreateGlobalTable via StockTablePath). In v10/v11 that
+// computation bottomed out in the compiled-in KICAD_LIBRARY_DATA
+// path, because patch 0028's iOS rooting of
+// PATHS::GetStockEDALibraryPath never reached the shipped
+// libkicommon -- the KICAD_IOS_PORT define sat on the `common`
+// CMake target, which compiles none of the patched sources
+// (patch 0032 puts the define on `kicommon`). The chain target
+// therefore names a file that does not exist and the stock
+// libraries never load -- and nothing ever repairs it: the user
+// table FILE parses, so GlobalTablesValid() stays true, the
+// wizard's library page is never offered again
+// (STARTWIZARD_PROVIDER_LIBRARIES::NeedsUserInput is false), and
+// the one upstream rewrite of such rows lives in the wizard's
+// IMPORT-settings flow, which an in-place upgrade never runs.
+//
+// This hoists that same rewrite to every manager launch (called
+// from kicad.cpp just before the start wizard runs, and before
+// LoadGlobalTables): for each global table type, if the chained
+// "KiCad" row names a file that is not a valid table while the
+// stock table path computed NOW is valid, re-point the row at
+// the current stock path and save. Fresh installs are untouched
+// (no user table yet, or the chain already names the live stock
+// table), and a user's own chained tables (any other nickname)
+// are never touched. Upstream logic is not altered; the block
+// exists only in this port's build.
+bool LIBRARY_MANAGER::RepairStockTableChains()
+{
+    bool repairedAny = false;
+
+    for( LIBRARY_TABLE_TYPE type : { LIBRARY_TABLE_TYPE::SYMBOL,
+                                     LIBRARY_TABLE_TYPE::FOOTPRINT,
+                                     LIBRARY_TABLE_TYPE::DESIGN_BLOCK } )
+    {
+        wxString stockPath = StockTablePath( type );
+
+        if( !IsTableValid( stockPath ) )
+            continue;
+
+        wxFileName fn( DefaultGlobalTablePath( type ) );
+
+        if( !fn.IsFileReadable() )
+            continue;
+
+        LIBRARY_TABLE table( fn, LIBRARY_TABLE_SCOPE::GLOBAL );
+
+        if( !table.IsOk() )
+            continue;
+
+        bool changed = false;
+
+        for( LIBRARY_TABLE_ROW& row : table.Rows() )
+        {
+            if( row.Type() == LIBRARY_TABLE_ROW::TABLE_TYPE_NAME
+                && row.Nickname() == wxT( "KiCad" )
+                && row.URI() != stockPath
+                && !IsTableValid( row.URI() ) )
+            {
+                wxLogTrace( traceLibraries,
+                            wxT( "Libraries repair: re-pointing chained stock "
+                                 "row from '%s' to '%s'" ),
+                            row.URI(), stockPath );
+                row.SetURI( stockPath );
+                changed = true;
+            }
+        }
+
+        if( changed )
+        {
+            table.Save();
+            repairedAny = true;
+        }
+    }
+
+    return repairedAny;
+}
+#endif
 
