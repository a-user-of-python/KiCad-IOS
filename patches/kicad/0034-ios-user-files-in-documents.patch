     m_perspective = aCfg->perspective;
     m_auiLayoutState = std::make_unique<nlohmann::json>( aCfg->aui_state );
     m_mruPath = aCfg->mru_path;
+#ifdef KICAD_IOS_PORT
+    // [KiCad-IOS port] Added 2026-11-07 for iOS (launch fix round 12,
+    // KiCad-Spike-v14): the persisted mru_path defaults to "" and,
+    // until a project has been loaded once, stays "", so the plain
+    // assignment above wipes the default that commonInit() set --
+    // the user projects directory -- and leaves GetMruPath() empty.
+    // The manager's file dialogs take their default directory from
+    // GetMruPath(); with it empty they fall back to the process
+    // working directory, which on iOS is the read-only app bundle,
+    // and creating a project there fails (v13 device report; see
+    // also the working-directory fix in APP_KICAD::OnInit). An empty
+    // persisted value therefore means the default projects
+    // directory on this port.
+    if( m_mruPath.IsEmpty() )
+        m_mruPath = PATHS::GetDefaultUserProjectsPath();
+#endif
 
     TOOLS_HOLDER::CommonSettingsChanged();
 }
