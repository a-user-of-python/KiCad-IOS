+        // [KiCad-IOS port] Added 2026-11-07 for iOS (launch fix
+        // round 12, KiCad-Spike-v14): move the process working
+        // directory to the app's Documents folder before anything
+        // can resolve a relative path. iOS launches the app with
+        // its working directory inside the application bundle,
+        // which is read-only, so every fallback that resolves
+        // against the working directory -- an empty file-dialog
+        // default directory above all -- lands in the bundle and
+        // fails: in the v13 device session a new project tried to
+        // create itself inside KiCad.app and was refused with
+        // "Operation not permitted". The port's rule is that user
+        // files live in the shared Documents directory. Everything
+        // the port itself locates (stock data, kiface modules,
+        // Python) is addressed by absolute paths and is unaffected.
+        wxSetWorkingDirectory( KIPLATFORM::ENV::GetDocumentsPath() );
