--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -1104,6 +1104,22 @@
 
 target_compile_definitions(pcbcommon PRIVATE PCBNEW)
 
+# [KiCad-IOS port] Added 2026-11-13 for iOS (round 22): define
+# KICAD_IOS_PORT for the pcbcommon target as well, the same
+# per-target define patches 0026/0032/0035 place on the kicad,
+# common, kicommon, gal and eeschema_kiface_objects targets.
+# Two of round 22's patched sources compile into pcbcommon,
+# not into the pcbnew kiface objects: pcbnew/pcb_base_frame.cpp
