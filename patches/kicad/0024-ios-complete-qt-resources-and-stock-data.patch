@@ -109,9 +132,34 @@
 //    the RHI and platform-integration logging categories so the next
 //    launch failure carries its reason in the log instead of a bare
 //    fault address.
+// 3) [Patch 0024] Stock data location. KiCad 10's BITMAP_STORE is
+//    FILE-based: its constructor opens an ASSET_ARCHIVE at
+//    PATHS::GetStockDataPath() + "/resources/images.tar.gz" and
+//    every KiBitmap() (all toolbar/launcher/dialog icons, starting
+//    with the manager frame's own) reads PNG data from it. The
+//    archive-open failure is graceful (each icon degrades to the
+//    built-in "image not found" placeholder), so a bundle without
+//    stock data does not crash -- it opens a manager window whose
+//    every icon is a placeholder. Up to v6 the bundle shipped no
+//    stock data at all, and the compiled-in KICAD_DATA path is a
+//    CI-machine sysroot path that cannot exist on device.
+//    PATHS::GetStockDataPath() consults the KICAD_STOCK_DATA_HOME
+//    environment variable before any platform branch (the literal
+//    is verifiably compiled into the shipped libkicommon), so the
+//    constructor below points it at the app bundle's share/
+//    directory, where the packaging step (scripts/package_ios.py)
+//    installs the build's own resources/images.tar.gz. This runs
+//    at load time, long before the lazily-constructed BITMAP_STORE
+//    (first KiBitmap call, in the manager frame constructor), and
+//    an externally-provided value is respected.
 extern int qInitResources_gui_shaders();
+extern int qInitResources_qpdf();
+extern int qInitResources_qstyle();
 extern int qInitResources_qstyle1();
 extern int qInitResources_qstyle_fusion();
+extern int qInitResources_qmessagebox();
+extern int qInitResources_qprintdialog();
+extern int qInitResources_qprintdialog1();
 
 namespace
 {
@@ -121,9 +169,35 @@
     {
         setenv( "QT_WIDGETS_RHI", "0", 1 );
         setenv( "QT_LOGGING_RULES", "qt.rhi.*=true;qt.qpa.*=true", 1 );
+
+        if( !std::getenv( "KICAD_STOCK_DATA_HOME" ) )
+        {
+            char     exePath[PATH_MAX];
+            uint32_t exeLen = sizeof( exePath );
+
+            if( _NSGetExecutablePath( exePath, &exeLen ) == 0 )
+            {
+                // Flat iOS layout: <...>/KiCad.app/KiCad -> the
+                // bundle root is the executable's directory.
+                char* slash = std::strrchr( exePath, '/' );
+
+                if( slash )
+                {
+                    *slash = '\0';
+                    std::string stockHome = std::string( exePath ) + "/share";
+                    setenv( "KICAD_STOCK_DATA_HOME", stockHome.c_str(), 1 );
+                }
+            }
+        }
+
         qInitResources_gui_shaders();
+        qInitResources_qpdf();
+        qInitResources_qstyle();
         qInitResources_qstyle1();
         qInitResources_qstyle_fusion();
+        qInitResources_qmessagebox();
+        qInitResources_qprintdialog();
+        qInitResources_qprintdialog1();
     }
 };
 
