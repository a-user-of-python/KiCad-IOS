 void SetAuiPaneSize( wxAuiManager& aManager, wxAuiPaneInfo& aPane, int aWidth, int aHeight )
 {
+    // [KiCad-IOS port] Added 2026-11-12 for iOS (round 20, KiCad
+    // patch 0049): never force a pane larger than the managed
+    // window can hold. Callers pass persisted pane sizes
+    // (aui.* keys in each app's settings) verbatim, and this
+    // function forces them with MinSize + Fixed() inside the
+    // frame -- internal AUI layout never passes through the
+    // wx-level top-level clamp, so a width banked in a wider
+    // display-scale era could take the whole frame on an upgrade
+    // install. Clamp each dimension to 85% of the managed
+    // window's LIVE client size. Negative (unset) dimensions
+    // pass through untouched.
+    if( wxWindow* managed = aManager.GetManagedWindow() )
+    {
+        wxSize client = managed->GetClientSize();
+
+        if( client.x >= 200 && aWidth > client.x * 85 / 100 )
+        {
+            aWidth = client.x * 85 / 100;
+            wxLogTrace( wxT( "KICAD_IOS" ), wxT( "round20-aui-pane-clamp" ) );
+        }
+
+        if( client.y >= 200 && aHeight > client.y * 85 / 100 )
+        {
+            aHeight = client.y * 85 / 100;
+            wxLogTrace( wxT( "KICAD_IOS" ), wxT( "round20-aui-pane-clamp" ) );
+        }
+    }
+
     wxSize minSize = aPane.min_size;
 
     // wxAUI hack: force width by setting MinSize() and then Fixed()
