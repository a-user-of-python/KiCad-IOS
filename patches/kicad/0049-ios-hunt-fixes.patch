 void SIMULATOR_FRAME_UI::SetSubWindowsSashSize()
 {
-    if( m_splitterLeftRightSashPosition > 0 )
-        m_splitterLeftRight->SetSashPosition( m_splitterLeftRightSashPosition );
-
-    if( m_splitterPlotAndConsoleSashPosition > 0 )
-        m_splitterPlotAndConsole->SetSashPosition( m_splitterPlotAndConsoleSashPosition );
-
-    if( m_splitterSignalsSashPosition > 0 )
-        m_splitterSignals->SetSashPosition( m_splitterSignalsSashPosition );
-
-    if( m_splitterCursorsSashPosition > 0 )
-        m_splitterCursors->SetSashPosition( m_splitterCursorsSashPosition );
-
-    if( m_splitterTuneValuesSashPosition > 0 )
-        m_splitterMeasurements->SetSashPosition( m_splitterTuneValuesSashPosition );
+    // [KiCad-IOS port] Modified 2026-11-12 for iOS (round 20, KiCad
+    // patch 0049): validate each persisted sash against its
+    // splitter's LIVE extent before applying it. Upstream's only
+    // check was > 0, and this frame host has no DIALOG_SHIM walk
+    // and no heal timer, so a sash banked in a wider display-scale
+    // era (e.g. plot_panel_width from a desktop session) took the
+    // whole frame on an upgrade install. A position outside
+    // [10%, 90%] of the live extent resets to the middle; in-band
+    // values apply verbatim.
+    auto applySash = []( wxSplitterWindow* aSplitter, int aPos )
+    {
+        if( aPos <= 0 )
+            return;
+
+        wxSize live = aSplitter->GetSize();
+        bool   horiz = aSplitter->GetSplitMode() == wxSPLIT_VERTICAL;
+        int    extent = horiz ? live.x : live.y;
+
+        if( extent >= 100 && ( aPos > extent * 90 / 100 || aPos < extent * 10 / 100 ) )
+        {
+            aPos = extent / 2;
+            wxLogTrace( wxT( "KICAD_IOS" ), wxT( "round20-sim-sash-clamp" ) );
+        }
+
+        aSplitter->SetSashPosition( aPos );
+    };
+
+    applySash( m_splitterLeftRight, m_splitterLeftRightSashPosition );
+    applySash( m_splitterPlotAndConsole, m_splitterPlotAndConsoleSashPosition );
+    applySash( m_splitterSignals, m_splitterSignalsSashPosition );
+    applySash( m_splitterCursors, m_splitterCursorsSashPosition );
+    applySash( m_splitterMeasurements, m_splitterTuneValuesSashPosition );
 }
 
 
