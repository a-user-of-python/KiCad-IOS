+/*
+ * [KiCad-IOS port] New file: KIPLATFORM::WEBVIEW cookie functions for
+ * the wxQt port. wxQt has no wxWebView backend (wxUSE_WEBVIEW is OFF),
+ * so there is no cookie store to read or write; the functions report
+ * failure, matching how the rest of the port behaves when the webview
+ * feature is compiled out (see patches/kicad/0002-webview-conditional).
+ */
+
+#include <kiplatform/webview.h>
+
+#include <wx/string.h>
+
+class wxWebView;
+
+namespace KIPLATFORM::WEBVIEW
+{
+
+bool SaveCookies( wxWebView* aWebView, const wxString& aTargetFile )
+{
+    return false;
+}
+
+
+bool LoadCookies( wxWebView* aWebView, const wxString& aSourceFile )
+{
+    return false;
+}
+
+
+bool DeleteCookies( wxWebView* aWebView )
+{
+    return false;
+}
+
+} // namespace KIPLATFORM::WEBVIEW
