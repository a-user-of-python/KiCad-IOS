+/*
+ * [KiCad-IOS port] New file: KIPLATFORM::UI implementation for the wxQt
+ * port (wxWidgets on Qt). KiCad's kiplatform layer ships per-port UI
+ * implementations (wxosx, wxmsw, wxgtk); without one for "qt" every
+ * KIPLATFORM::UI symbol is undefined at link time.
+ *
+ * Qt provides these facilities through wxWidgets itself, so this
+ * implementation is deliberately wx-generic: it uses wxSystemSettings,
+ * wxWindow and wxTopLevelWindow only. Functions that exist solely to
+ * work around native-toolkit behaviour on macOS/GTK (child-window
+ * ordering, cmd-key collisions, cell-layout hacks, Wayland pointer
+ * confinement, overlay scrolling, IME fixups) are no-ops here, exactly
+ * as the GTK port no-ops the macOS ones and vice versa.
+ */
+
+#include <kiplatform/ui.h>
+
+#include <wx/choice.h>
+#include <wx/dialog.h>
+#include <wx/nonownedwnd.h>
+#include <wx/settings.h>
+#include <wx/toplevel.h>
+#include <wx/utils.h>
+#include <wx/window.h>
+
+
+bool KIPLATFORM::UI::IsDarkTheme()
+{
+    wxColour bg = wxSystemSettings::GetColour( wxSYS_COLOUR_WINDOW );
+
+    // Weighted W3C formula (same computation as the GTK port)
+    double brightness = ( bg.Red() / 255.0 ) * 0.299 +
+                        ( bg.Green() / 255.0 ) * 0.587 +
+                        ( bg.Blue() / 255.0 ) * 0.117;
+
+    return brightness < 0.5;
+}
+
+
+wxColour KIPLATFORM::UI::GetDialogBGColour()
+{
+    return wxSystemSettings::GetColour( wxSYS_COLOUR_BTNFACE );
+}
+
+
+void KIPLATFORM::UI::GetInfoBarColours( wxColour& aFgColour, wxColour& aBgColour )
+{
+    aBgColour = wxSystemSettings::GetColour( wxSYS_COLOUR_INFOBK );
+    aFgColour = wxSystemSettings::GetColour( wxSYS_COLOUR_INFOTEXT );
+}
+
+
+void KIPLATFORM::UI::ForceFocus( wxWindow* aWindow )
+{
+    aWindow->SetFocus();
+
+    // Present the containing top-level window so it actually receives
+    // keyboard events (the wx-generic equivalent of the GTK port's
+    // gtk_window_present call).
+    wxTopLevelWindow* tlw = wxGetTopLevelParent( aWindow );
+
+    if( tlw )
+        tlw->Raise();
+}
+
+
+bool KIPLATFORM::UI::IsWindowActive( wxWindow* aWindow )
+{
+    if( !aWindow )
+        return false;
+
+    wxTopLevelWindow* tlw = wxGetTopLevelParent( aWindow );
+
+    return tlw && tlw->IsActive();
+}
+
+
+void KIPLATFORM::UI::EnsureVisible( wxWindow* aWindow )
+{
+    // macOS Spaces workaround; not needed under Qt
+}
+
+
+void KIPLATFORM::UI::ReparentModal( wxNonOwnedWindow* aWindow )
+{
+    // macOS child-window ordering only; not needed under Qt
+}
+
+
+void KIPLATFORM::UI::ReparentWindow( wxNonOwnedWindow* aWindow, wxTopLevelWindow* aParent )
+{
+    // macOS child-window ordering only; not needed under Qt
+}
+
+
+void KIPLATFORM::UI::FixupCancelButtonCmdKeyCollision( wxWindow* aWindow )
+{
+    // macOS cmd-key accelerator collision only; not applicable under Qt
+}
+
+
+bool KIPLATFORM::UI::IsStockCursorOk( wxStockCursor aCursor )
+{
+    switch( aCursor )
+    {
+    case wxCURSOR_BULLSEYE:
+    case wxCURSOR_HAND:
+    case wxCURSOR_ARROW:
+    case wxCURSOR_BLANK:
+        return true;
+    default:
+        return false;
+    }
+}
+
+
+void KIPLATFORM::UI::LargeChoiceBoxHack( wxChoice* aChoice )
+{
+    // GTK cell-layout performance hack; QComboBox handles large lists
+    // natively, nothing to do under Qt
+}
+
+
+void KIPLATFORM::UI::EllipsizeChoiceBox( wxChoice* aChoice )
+{
+    // QComboBox ellipsizes its button text itself; nothing to do
+}
+
+
+double KIPLATFORM::UI::GetPixelScaleFactor( const wxWindow* aWindow )
+{
+    // Under wxQt the content scale factor is the widget's device pixel
+    // ratio, which is exactly the pixel scale KiCad asks for.
+    return aWindow->GetContentScaleFactor();
+}
+
+
+double KIPLATFORM::UI::GetContentScaleFactor( const wxWindow* aWindow )
+{
+    return aWindow->GetContentScaleFactor();
+}
+
+
+wxSize KIPLATFORM::UI::GetUnobscuredSize( const wxWindow* aWindow )
+{
+    return wxSize( aWindow->GetSize().GetX() - wxSystemSettings::GetMetric( wxSYS_VSCROLL_X ),
+                   aWindow->GetSize().GetY() - wxSystemSettings::GetMetric( wxSYS_HSCROLL_Y ) );
+}
+
+
+void KIPLATFORM::UI::SetOverlayScrolling( const wxWindow* aWindow, bool overlay )
+{
+    // Implemented only on GTK (see ui.h)
+}
+
+
+bool KIPLATFORM::UI::AllowIconsInMenus()
+{
+    // No system-wide "no icons in menus" setting exists under Qt
+    return true;
+}
+
+
+wxPoint KIPLATFORM::UI::GetMousePosition()
+{
+    return wxGetMousePosition();
+}
+
+
+bool KIPLATFORM::UI::WarpPointer( wxWindow* aWindow, int aX, int aY )
+{
+    aWindow->WarpPointer( aX, aY );
+    return true;
+}
+
+
+void KIPLATFORM::UI::ImmControl( wxWindow* aWindow, bool aEnable )
+{
+    // Qt routes IME through wxQt's input-method handling; no per-window
+    // fixup needed
+}
+
+
+void KIPLATFORM::UI::ImeNotifyCancelComposition( wxWindow* aWindow )
+{
+    // See ImmControl
+}
+
+
+bool KIPLATFORM::UI::InfiniteDragPrepareWindow( wxWindow* aWindow )
+{
+    // No pointer confinement protocol to set up (that is a Wayland/GTK
+    // concern); warping alone drives infinite panning, as on X11.
+    return true;
+}
+
+
+void KIPLATFORM::UI::InfiniteDragReleaseWindow()
+{
+    // Nothing was prepared, nothing to release
+}
+
+
+void KIPLATFORM::UI::SetFloatLevel( wxWindow* aWindow )
+{
+    // macOS window levels only; not applicable under Qt
+}
+
+
+void KIPLATFORM::UI::ReleaseChildWindow( wxNonOwnedWindow* aWindow )
+{
+    // macOS modal child-window relationship only; not applicable
+}
+
+
+void KIPLATFORM::UI::AllowNetworkFileSystems( wxDialog* aDialog )
+{
+    // Qt file dialogs show network and virtual filesystems by default
+    // (and the in-app file lists used on iOS do too)
+}
