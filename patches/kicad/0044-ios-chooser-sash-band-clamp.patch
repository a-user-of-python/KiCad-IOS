# KiCad-IOS port patch 0044 (KiCad 10.0.1, GPL-3.0)
# Round 18, Job T: chooser previews squished to the side.
# The chooser panels persist splitter sash positions as absolute
# pixels (eeschema/pcbnew settings) and DIALOG_SHIM persists
# them again in common settings; both restore verbatim, while
# the dialog size they divide is restored through the port's
# geometry clamp. After the port's display-scale recalibrations
# (0.5 -> 0.6 -> 0.75) the saved pair desynchronises and the
# sash collapses the preview pane to the splitter minimum; the
# panels' destructors then re-save the pathological value, so
# it never heals. This patch band-clamps every restored sash
# to a fraction of its splitter's live size at both restore
# chokepoints (the three chooser panels' FinishSetup() and
# DIALOG_SHIM::LoadControlState()) and writes the healed value
# back so the existing saves re-bank it. In-band user sash
# drags are preserved exactly.
# Apply with: patch -p1 (from the KiCad source root), after
# patches 0001-0043.
#
--- a/eeschema/widgets/panel_symbol_chooser.cpp
+++ b/eeschema/widgets/panel_symbol_chooser.cpp
@@ -430,6 +430,38 @@
         if( panelCfg.sash_pos_v < 0 )
             panelCfg.sash_pos_v = horizPixelsFromDU( 230 );
 
+        // [KiCad-IOS port] Modified 2026-11-09 for iOS (round 18, Job T,
+        // KiCad patch 0044): the persisted sash positions are absolute
+        // pixels with no scale annotation, while the width restored
+        // above passes through the port's geometry clamp -- after a
+        // display-scale recalibration the two desynchronise, and a
+        // verbatim sash can collapse a pane to the splitter minimum.
+        // Validate each sash against a fraction band of its splitter's
+        // live size and write the healed value back to the settings
+        // struct, so the destructor's unconditional save re-banks the
+        // heal rather than the poison. In-band user drags are
+        // untouched.
+        auto clampSash =
+                [&]( wxSplitterWindow* aSplitter, int aSash, bool aHorizontal ) -> int
+                {
+                    wxSize live = aSplitter->GetSize();
+                    int    extent = aHorizontal ? live.x : live.y;
+
+                    if( extent < 100 )
+                        extent = aHorizontal ? w : h;
+
+                    int minPane = aSplitter->GetMinimumPaneSize();
+                    int lo = wxMax( minPane, extent * 15 / 100 );
+                    int hi = extent * ( aHorizontal ? 65 : 75 ) / 100;
+
+                    return wxMax( lo, wxMin( aSash, wxMax( lo, hi ) ) );
+                };
+
+        panelCfg.sash_pos_h = clampSash( m_hsplitter, panelCfg.sash_pos_h, true );
+
+        if( m_vsplitter )
+            panelCfg.sash_pos_v = clampSash( m_vsplitter, panelCfg.sash_pos_v, false );
+
         m_hsplitter->SetSashPosition( panelCfg.sash_pos_h );
 
         if( m_vsplitter )
