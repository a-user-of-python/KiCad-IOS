+    // [KiCad-IOS port] Modified 2026-11-09 for iOS (round 16,
+    // KiCad-Spike-v16): set a top-level window's full geometry,
+    // through wx when the window has a wx counterpart so wx's
+    // bookkeeping (and patch 0009's clamp, inside
+    // wxWindowQt::DoMoveWindow()) stays authoritative.
+    void setWindowRect( QWidget *w, const QRect &rect )
+    {
+        if ( wxWindowQt *wxWin =
+                wxWindowQt::QtRetrieveWindowPointer( w ) )
+        {
+            wxWin->SetSize( rect.x(), rect.y(),
+                            rect.width(), rect.height() );
+            return;
+        }
+
+        w->setGeometry( rect );
+    }
+
+    // [KiCad-IOS port] Modified 2026-11-09 for iOS (round 16,
+    // KiCad-Spike-v16): if the dragged window is maximized or
+    // full-screen, return it to a floating window BEFORE the
+    // first drag move. On the iOS QPA, QIOSWindow::setGeometry()
+    // does not apply the rect while windowState() !=
+    // Qt::WindowNoState -- it bookkeeps it as the normal geometry
+    // and the following layout reports the actual (maximized)
+    // geometry back -- so a maximized window (KiCad's editor
+    // frames are maximized by default) cannot be dragged at all,
+    // however correct the move calls are. Desktop Qt clears the
+    // state on setGeometry instead, which is why this defect was
+    // invisible to every host harness before this round.
+    // QWidget::showNormal() is the same call
+    // wxTopLevelWindowQt::Restore() makes; it is followed by an
+    // explicit floating geometry (the window's normal geometry
+    // when sane, else three quarters of the available screen,
+    // positioned so the window follows the pointer's travel so
+    // far), and the drag is re-baselined onto that rect so the
+    // motion stays continuous.
+    void ensureFloatingForDrag( QWidget *w, const QPoint &globalPos )
+    {
+        if ( !( w->windowState()
+                & ( Qt::WindowMaximized | Qt::WindowFullScreen ) ) )
+            return;
+
+        QScreen *screen = QGuiApplication::primaryScreen();
+        if ( !screen )
+            return;
+
+        const QRect avail = screen->availableGeometry();
+        QRect rect = w->normalGeometry();
+
+        if ( !rect.isValid() || rect.isEmpty()
+                || rect.width() > avail.width()
+                || rect.height() > avail.height() )
+        {
+            rect = QRect( avail.left() + avail.width() / 8,
+                          avail.top() + avail.height() / 8,
+                          avail.width() * 3 / 4,
+                          avail.height() * 3 / 4 );
+        }
+
+        // The floating window starts where the maximized one sat
+        // (the available geometry's origin), shifted by the
+        // pointer's travel so far, bounded so the whole floating
+        // rect stays on screen.
+        QPoint pos = avail.topLeft() + ( globalPos - m_pressGlobal );
+        pos.setX( qBound( avail.left(), pos.x(),
+                          qMax( avail.left(),
+                                avail.right() - rect.width() + 1 ) ) );
+        pos.setY( qBound( avail.top(), pos.y(),
+                          qMax( avail.top(),
+                                avail.bottom() - rect.height() + 1 ) ) );
+        rect.moveTopLeft( pos );
+
+        w->showNormal();
+        setWindowRect( w, rect );
+
+        m_dragStartPos = rect.topLeft();
+        m_pressGlobal = globalPos;
+    }
