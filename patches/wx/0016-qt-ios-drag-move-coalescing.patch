+    // apply any coalesced move still pending; called on release and on
+    // TouchCancel so a drag always ends at the pointer's last position.
+    void flushDragMove()
+    {
+        m_dragMoveTimer.stop();
+
+        if ( !m_havePendingDragMove )
+            return;
+
+        m_havePendingDragMove = false;
+
+        if ( !m_dragWindow.isNull() )
+            moveWindowTo( m_dragWindow, m_pendingDragPos );
     }
 
