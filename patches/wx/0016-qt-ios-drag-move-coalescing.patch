+    // [KiCad-IOS port] Modified 2026-11-09 for iOS (round 16, KiCad-V1):
+    // apply a drag move, coalescing bursts of pointer samples. Before
+    // this change every TouchUpdate -- and every synthesized MouseMove
+    // for the same physical sample, which the event filter also feeds
+    // to updateDrag() -- synchronously drove a full wx Move() into the
+    // iOS QPA, whose applyGeometry() forces a synchronous layout pass
+    // and window-system event flush per call (QIOSWindow::applyGeometry:
+    // "[m_view layoutIfNeeded]" for QWidgetWindow), at up to the touch
+    // sample rate. The device result was a window that trailed the
+    // finger badly ("quite laggy when moving around"): each sample's
+    // geometry work ran inline before the next sample could be
+    // delivered, and any paint queued behind it ran inline too. Now
+    // the first move of a burst applies immediately, moves inside one
+    // kDragMoveIntervalMs window only record the LATEST target, and
+    // the timer applies that one -- the window still follows live at
+    // display rate, intermediate positions nobody could see are never
+    // paid for, and flushDragMove() on release/cancel lands the window
+    // exactly under the pointer, so the final geometry is identical
+    // to the uncoalesced drag.
+    void queueDragMove( const QPoint &pos )
+    {
+        if ( m_dragMoveTimer.isActive() )
+        {
+            m_pendingDragPos = pos;
+            m_havePendingDragMove = true;
+            return;
+        }
+
+        moveWindowTo( m_dragWindow, pos );
+        m_dragMoveTimer.start( kDragMoveIntervalMs );
+    }
