-bool wxWindowQt::QtHandleFocusEvent ( QWidget *WXUNUSED( handler ), QFocusEvent *event )
+bool wxWindowQt::QtIsStyledTextCtrlWindow() const
+{
+    // [KiCad-IOS port] Added 2026-11-12 for iOS (round 21, wx
+    // patch 0031): identify STC windows by RTTI class name so
+    // wxCore needs no dependency on the STC library.
+    const wxClassInfo* info = GetClassInfo();
+
+    return info && wxString( info->GetClassName() ) == wxT( "wxStyledTextCtrl" );
+}
+
+bool wxWindowQt::QtHandleInputMethodEvent ( QWidget *WXUNUSED( handler ),
+                                            QInputMethodEvent *event )
+{
+    // [KiCad-IOS port] Added 2026-11-12 for iOS (round 21, wx
+    // patch 0031): deliver the input method's committed text to
+    // a wxStyledTextCtrl as wxEVT_CHAR events, the same channel
+    // hardware keys already reach it through (QtHandleKeyEvent
+    // -> wxEVT_CHAR -> wxStyledTextCtrl::OnChar -> DoAddChar).
+    // Inert for every other window. The preedit string is
+    // ignored in v1 (noted limitation: no composition preview;
+    // committed text only, which is what the iOS keyboard sends
+    // for plain typing). Trace literal
+    // "round21-stc-input-method-bridge" is the shipped-binary
+    // gate marker for this patch.
+    if ( !QtIsStyledTextCtrlWindow() || !event )
+        return false;
+
+    const QString commit = event->commitString();
+
+    wxLogTrace( "kicad-ios-round21",
+                "round21-stc-input-method-bridge: commit %d char(s)",
+                (int) commit.length() );
+
+    for ( int i = 0; i < commit.length(); ++i )
+    {
+        const QChar ch = commit.at( i );
+
+        wxKeyEvent e( wxEVT_CHAR );
+        e.SetEventObject( this );
+        e.m_keyCode = ch.unicode();
+        e.m_uniChar = static_cast<wxChar>( ch.unicode() );
+
+        ProcessWindowEvent( e );
+    }
+
+    return true;
+}
+
+QVariant wxWindowQt::QtHandleInputMethodQuery ( QWidget *WXUNUSED( handler ),
+                                                Qt::InputMethodQuery query )
+{
+    // [KiCad-IOS port] Added 2026-11-12 for iOS (round 21, wx
+    // patch 0031): answer the two queries Qt's iOS input context
+    // needs before it will show the keyboard for an STC window.
+    // An invalid QVariant for everything else (and for every
+    // non-STC window) makes the caller in winevent.h fall back
+    // to the widget's default Qt behaviour, unchanged.
+    if ( !QtIsStyledTextCtrlWindow() )
+        return QVariant();
+
+    switch ( query )
+    {
+        case Qt::ImEnabled:
+            return QVariant( true );
+
+        case Qt::ImCursorRectangle:
+            // Approximate cursor rect at the widget origin: good
+            // enough for keyboard placement in v1.
+            return QVariant( QRectF( 0, 0, 1, 1 ) );
+
+        default:
+            return QVariant();
+    }
+}
+
+bool wxWindowQt::QtHandleFocusEvent ( QWidget *handler, QFocusEvent *event )
 {
+    // [KiCad-IOS port] Modified 2026-11-12 for iOS (round 21, wx
+    // patch 0031): for wxStyledTextCtrl windows only, (re)assert
+    // the input-method attribute and drive the iOS virtual
+    // keyboard explicitly on focus gain/loss. No other window's
+    // focus behaviour changes.
+    if ( QtIsStyledTextCtrlWindow() && handler )
+    {
+        handler->setAttribute( Qt::WA_InputMethodEnabled, true );
+
+        if ( QInputMethod* im = QGuiApplication::inputMethod() )
+        {
+            if ( event->gotFocus() )
+                im->show();
+            else
+                im->hide();
+        }
+    }
+
     wxFocusEvent e( event->gotFocus() ? wxEVT_SET_FOCUS : wxEVT_KILL_FOCUS, GetId() );
     e.SetEventObject(this);
     e.SetWindow(event->gotFocus() ? this : FindFocus());
