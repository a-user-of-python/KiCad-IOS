+    // [KiCad-IOS port] Added 2026-11-12 for iOS (round 21, wx
+    // patch 0031): forward input-method events to the wxWindowQt
+    // handlers. Those handlers are inert for every window except
+    // wxStyledTextCtrl, in which case we accept the event and do
+    // NOT fall through to the Widget default; all other widgets
+    // keep exactly the default Qt behaviour they had before.
+    virtual void inputMethodEvent ( QInputMethodEvent * event ) override
+    {
+        if ( !this->GetHandler() )
+            return;
+
+        if ( !this->GetHandler()->QtHandleInputMethodEvent(this, event) )
+            Widget::inputMethodEvent(event);
+        else
+            event->accept();
+    }
+
+    virtual QVariant inputMethodQuery ( Qt::InputMethodQuery query ) const override
+    {
+        if ( this->GetHandler() )
+        {
+            QVariant result =
+                this->GetHandler()->QtHandleInputMethodQuery(
+                    const_cast<wxQtEventSignalHandler*>(this), query );
+
+            if ( result.isValid() )
+                return result;
+        }
+
+        return Widget::inputMethodQuery(query);
+    }
