+    // --- external display (round 16, KiCad-V1, Job J) -----------
+    // [KiCad-IOS port] Added 2026-11-09 for iOS (round 16, KiCad-V1):
+    // external display (extended, not mirrored).
+    //
+    // The Qt 6.9 iOS QPA enumerates every UIScreen in
+    // QGuiApplication::screens(): QIOSScreen::initializeScreens() adds
+    // one QIOSScreen per entry of [UIScreen screens], and
+    // QIOSScreenTracker adds/removes one on UIScreenDidConnect /
+    // UIScreenDidDisconnect notifications (qtbase
+    // src/plugins/platforms/ios/qiosscreen.mm). An external screen is
+    // named "External display" by QIOSScreen::name(). Assigning a
+    // QWindow to it is a designed QPA path, not a hack:
+    // QIOSWindow::setParent() parents a top-level view into
+    // rootViewForScreen(window()->screen()), i.e. into the target
+    // screen's own UIWindow/desktop-manager view, and
+    // QIOSDesktopManagerView's didAddSubview explicitly un-hides that
+    // screen's UIWindow the first time a QWindow maps to it -- "for
+    // external screens this disables mirroring of the main screen, so
+    // the external screen can be used for alternate content"
+    // (qiosviewcontroller.mm). wxQt already passes the enumeration
+    // through: wxDisplayFactoryQt::GetCount() returns
+    // QApplication::screens().size() (src/qt/display.cpp).
+    //
+    // Two QPA facts shape the implementation:
+    //   * Every QIOSScreen's geometry has origin (0,0) -- it is
+    //     UIScreen.bounds verbatim -- so the screens' coordinate
+    //     spaces OVERLAP. Placement by global coordinates alone can
+    //     never move a window between displays; the move must assign
+    //     the screen first (QWindow::setScreen) and only then set
+    //     geometry, in the target screen's local coordinates.
+    //   * Filling a screen is done with the state primitive
+    //     (showMaximized), the same one Job D proved is the only
+    //     geometry operation the QPA always honours: setGeometry() on
+    //     a maximized/full-screen window is bookkeeping only.
+    //
+    // Each titlebar strip therefore carries an "Ext" button
+    // (objectName "wxQtIOSExternalDisplayButton", shown only while a
+    // second screen exists or a window is already external). It
+    // toggles: if a window is on an external screen, bring THAT
+    // window back (so a return control always exists on the iPad
+    // side, on whichever window's strip is used); otherwise move
+    // THIS strip's window to the external screen, maximized at that
+    // screen's native size. The iPad-side geometry/state are saved
+    // for the return trip, and a screen disconnect returns any
+    // external window automatically. HONEST LABEL: this is extended
+    // desktop at the QPA level, shipped without device proof; how
+    // much pointer/keyboard input iPadOS routes to a window on an
+    // external UIScreen is only settled by the round 16 device
+    // test. (Merged into the per-window titlebar design by the
+    // round 16 coordinator: patch 0019 was written against the
+    // retired single roaming bar; the toggle now lives on every
+    // strip with the same objectName and acts on the strip's own
+    // window, exactly as patch 0019's own porting note prescribed.)
+
+    // The first non-primary screen, or nullptr.
+    static QScreen *externalScreen()
+    {
+        QScreen *primary = QGuiApplication::primaryScreen();
+
+        for ( QScreen *s : QGuiApplication::screens() )
+        {
+            if ( s != primary )
+                return s;
+        }
+        return nullptr;
+    }
+
+    // A tracked, visible window currently living on a non-primary
+    // screen, or nullptr.
+    QWidget *windowOnExternalScreen() const
+    {
+        QScreen *primary = QGuiApplication::primaryScreen();
+
+        for ( QWidget *w : m_history )
+        {
+            if ( !w || !w->isVisible() )
+                continue;
+            if ( QWindow *qw = w->windowHandle() )
+            {
+                if ( qw->screen() && qw->screen() != primary )
+                    return w;
+            }
+        }
+        return nullptr;
+    }
+
+    void updateExtButtons()
+    {
+        const bool show = externalScreen() != nullptr
+                || windowOnExternalScreen() != nullptr;
+
+        for ( StripWidgets &tb : m_titleBars )
+        {
+            if ( !tb.extBtn.isNull() )
+                tb.extBtn->setVisible( show );
+        }
+    }
+
+    void toggleExternalDisplay( QWidget *stripWindow )
+    {
+        // Return wins: while any window is external, the button
+        // brings THAT window back, so a return control always
+        // exists on the iPad side (on whichever window's strip is
+        // used) even though the moved window took its own strip
+        // with it.
+        if ( QWidget *ext = windowOnExternalScreen() )
+        {
+            returnWindowToPrimary( ext );
+            return;
+        }
+
+        if ( stripWindow )
+            moveWindowToExternal( stripWindow );
+    }
+
+    void moveWindowToExternal( QWidget *w )
+    {
+        if ( !w || m_docked.contains( w ) )
+            return;
+
+        // Frames only: a modal dialog belongs to its owner's
+        // screen and session.
+        if ( w->isModal() )
+            return;
+
+        QWindow *qw = w->windowHandle();
+        QScreen *primary = QGuiApplication::primaryScreen();
+        QScreen *target = externalScreen();
+
+        if ( !qw || !primary || !target || qw->screen() != primary )
+            return;
+
+        // Save the iPad-side state for the return trip: the
+        // floating geometry (normalGeometry() while maximized)
+        // and whether the window filled the screen.
+        m_extSavedRect[w] = ( w->isMaximized() || w->isFullScreen() )
+                ? w->normalGeometry() : w->geometry();
+        m_extSavedMaximized[w] = w->isMaximized() || w->isFullScreen();
+
+        // Out of maximized/full-screen first: in those states
+        // QIOSWindow::setGeometry() is bookkeeping only (Job D),
+        // and the screen assignment must reparent a floating
+        // window's view into the target screen's UIWindow.
+        if ( w->isMaximized() || w->isFullScreen() )
+            w->showNormal();
+
+        qw->setScreen( target );
+
+        // Fill the external screen at ITS native size: geometry
+        // is screen-local on this QPA, and showMaximized() is
+        // the state primitive the QPA always honours -- it sizes
+        // the window to screen()->availableGeometry() of the
+        // screen the window is now on.
+        w->setGeometry( target->availableGeometry() );
+        w->showMaximized();
+        qw->requestActivate();
+
+        noteWindow( w );
+        updateExtButtons();
+    }
+
+    void returnWindowToPrimary( QWidget *w )
+    {
+        if ( !w )
+            return;
+
+        QWindow *qw = w->windowHandle();
+        QScreen *primary = QGuiApplication::primaryScreen();
+
+        if ( !qw || !primary )
+            return;
+
+        const bool haveSaved = m_extSavedRect.contains( w );
+        const QRect saved = m_extSavedRect.take( w );
+        const bool wasMaximized = m_extSavedMaximized.take( w );
+
+        if ( w->isMaximized() || w->isFullScreen() )
+            w->showNormal();
+
+        if ( qw->screen() != primary )
+            qw->setScreen( primary );
+
+        // The saved rect was taken on this same primary screen;
+        // the (now screen-aware) Show()/DoMoveWindow clamps
+        // guard the pathological cases.
+        if ( haveSaved && saved.isValid() && !saved.isEmpty() )
+            w->setGeometry( saved );
+
+        if ( wasMaximized )
+            w->showMaximized();
+
+        qw->requestActivate();
+
+        noteWindow( w );
+        updateExtButtons();
+    }
