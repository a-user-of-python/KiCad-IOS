+// [KiCad-IOS port] Added 2026-11-09 for iOS (round 16, KiCad-V1):
+// the virtual cursor's arrow. A plain child widget (never a
+// top-level window -- see the Job H note above), transparent to
+// mouse input so it can never be the widget a click lands on,
+// painting a high-contrast north-west arrow whose hot spot is
+// at (3, 2) inside its 26x26 rect.
+class wxQtIOSVirtualCursorWidget : public QWidget
+{
+public:
+    explicit wxQtIOSVirtualCursorWidget( QWidget *parent )
+        : QWidget( parent )
+    {
+        setObjectName( QStringLiteral( "wxQtIOSVirtualCursor" ) );
+        setFixedSize( 26, 26 );
+        setAttribute( Qt::WA_TransparentForMouseEvents, true );
+        setAttribute( Qt::WA_TranslucentBackground, true );
+        setAttribute( Qt::WA_NoSystemBackground, true );
+    }
+
+    static QPoint hotSpot() { return QPoint( 3, 2 ); }
+
+protected:
+    void paintEvent( QPaintEvent * ) override
+    {
+        QPainter painter( this );
+        painter.setRenderHint( QPainter::Antialiasing, true );
+
+        QPolygonF arrow;
+        arrow << QPointF( 3, 2 ) << QPointF( 3, 19 )
+              << QPointF( 8, 15 ) << QPointF( 11, 22.5 )
+              << QPointF( 14.5, 21 ) << QPointF( 11.5, 14 )
+              << QPointF( 18, 14 );
+
+        painter.setPen( QPen( Qt::black, 1.6, Qt::SolidLine,
+                              Qt::RoundCap, Qt::RoundJoin ) );
+        painter.setBrush( Qt::white );
+        painter.drawPolygon( arrow );
+    }
+};
