+// ---------------------------------------------------------------------------
+// [KiCad-IOS port] Added 2026-11-09 for iOS (round 16, KiCad-V1):
+// the universal top-level geometry clamp, shared by every geometry
+// entry point (wxWindowQt::DoMoveWindow(), wxWindowQt::
+// DoSetClientSize() and wxTopLevelWindowQt::Show()).
+//
+// KiCad's dialogs and frames are sized for desktop monitors: the
+// editor frames' default size is 1280x720, PAGED_DIALOG (Preferences,
+// Schematic Setup, Board Setup) sets its minimum to the best size of
+// its widest page -- floored at 600x500 and "failsafe"-capped only at
+// 1500x900 -- and both frames (EDA_BASE_FRAME::LoadWindowState()) and
+// dialogs (DIALOG_SHIM::Show(), which re-applies the persisted
+// __geometry with SetSize() AFTER wxDialog::Show() has run, growing
+// to max(current, restored)) restore persisted sizes verbatim. The
+// iPad panel is 1180x820 pt, so any of those can put a window's
+// right/bottom edge -- and its OK/Close buttons -- off-screen, and
+// this platform has no window manager to pull it back. Patch 0009
+// clamped only the position in DoMoveWindow() (an oversized window
+// was pinned to the top-left corner and still overflowed) and the
+// size only in Show() (which DIALOG_SHIM's post-Show SetSize()
+// undid). This helper is the single full clamp both hooks now use:
+// size AND position, at set time as well as at show time, so the
+// persisted-restore paths above are caught by construction -- they
+// all funnel through wx SetSize()/Move().
+//
+// Screen choice: the display the rect belongs to, not blindly the
+// primary screen (an external display is a parallel round's work and
+// must not be broken by a primary-screen assumption). The proposed
+// rect's biggest-overlap screen wins -- the same rule wx's own
+// wxDisplayFactory::GetFromWindow() uses (src/common/dpycmn.cpp:
+// GetFromRect(), biggest intersection) -- falling back to the
+// widget's current screen and then to the primary screen. The clamp
+// target is that screen's availableGeometry(), the same value
+// wxDisplayImplQt::GetClientArea() reports to wx code.
+//
+// Minimum sizes: QWidget/QWindow refuse any geometry smaller than
+// their minimum size, so a dialog whose sizer minimum exceeds the
+// screen (the PAGED_DIALOG case above) would silently stay oversized
+// even with its requested size clamped. When -- and only when -- a
+// minimum exceeds the available geometry, the helper lowers that
+// minimum to the available size first (widget and QWindow alike;
+// the floating-controls dock in toplevel.cpp suspends minima the
+// same way). The minimum is only ever lowered toward the screen,
+// never raised, and KiCad re-asserts its minima on its own layout
+// passes (e.g. PAGED_DIALOG::onPageChanged()), which the next clamp
+// call caps again. Content laid out for the larger minimum is then
+// clipped by Qt inside a screen-fitting window: the titlebar area
+// and the window's own move/close affordances stay reachable, which
+// is the guarantee this clamp can honestly make (see the round 16
+// Job I findings for the dialogs whose content minimum still
+// exceeds the screen).
+//
+// Maximized, full-screen and minimized windows are left alone:
+// their geometry is owned by the window state (on the iOS QPA a
+// setGeometry() in those states is discarded anyway), KiCad's
+// frames are maximized deliberately (KiCad patch 0037), and the
+// floating-controls drag un-maximizes before it moves a window.
+// ---------------------------------------------------------------------------
+QRect wxQtIOSClampTopLevelRect( QWidget *widget, const QRect& rect )
+{
+    if ( !widget || rect.width() <= 0 || rect.height() <= 0 )
+        return rect;
+
+    if ( widget->isMaximized() || widget->isFullScreen()
+            || widget->isMinimized() )
+        return rect;
+
+    QScreen *screen = nullptr;
+    int bestArea = 0;
+
+    for ( QScreen *candidate : QGuiApplication::screens() )
+    {
+        const QRect overlap = candidate->availableGeometry().intersected( rect );
+        const int area = overlap.width() * overlap.height();
+
+        if ( area > bestArea )
+        {
+            bestArea = area;
+            screen = candidate;
+        }
+    }
+
+    if ( !screen )
+        screen = widget->screen();
+
+    if ( !screen )
+        screen = QGuiApplication::primaryScreen();
+
+    if ( !screen )
+        return rect;
+
+    const QRect avail = screen->availableGeometry();
+
+    if ( avail.isEmpty() )
+        return rect;
+
+    const QSize minSize = widget->minimumSize();
+
+    if ( minSize.width() > avail.width() || minSize.height() > avail.height() )
+    {
+        widget->setMinimumSize( qMin( minSize.width(), avail.width() ),
+                                qMin( minSize.height(), avail.height() ) );
+    }
+
+    if ( QWindow *window = widget->windowHandle() )
+    {
+        const QSize winMinSize = window->minimumSize();
+
+        if ( winMinSize.width() > avail.width()
+                || winMinSize.height() > avail.height() )
+        {
+            window->setMinimumSize( QSize( qMin( winMinSize.width(), avail.width() ),
+                                           qMin( winMinSize.height(), avail.height() ) ) );
+        }
+    }
+
+    QRect clamped = rect;
+
+    if ( clamped.width() > avail.width() )
+        clamped.setWidth( avail.width() );
+    if ( clamped.height() > avail.height() )
+        clamped.setHeight( avail.height() );
+
+    clamped.moveLeft( qBound( avail.left(), clamped.left(),
+                              avail.right() - clamped.width() + 1 ) );
+    clamped.moveTop( qBound( avail.top(), clamped.top(),
+                             avail.bottom() - clamped.height() + 1 ) );
+
+    if ( clamped != rect )
+    {
+        // [KiCad-IOS port] Added 2026-11-09 for iOS (round 16,
+        // KiCad-V1): trace literal doubling as the shipped-binary
+        // gate marker proving this clamp is compiled into the
+        // shipped wx library (Job I gate: strings | grep
+        // "jobi-universal-clamp").
+        wxLogTrace( "kicad-ios-round16",
+                    "jobi-universal-clamp: (%d, %d %dx%d) -> (%d, %d %dx%d), "
+                    "available (%d, %d %dx%d)",
+                    rect.x(), rect.y(), rect.width(), rect.height(),
+                    clamped.x(), clamped.y(), clamped.width(), clamped.height(),
+                    avail.x(), avail.y(), avail.width(), avail.height() );
+    }
+
+    return clamped;
+}
+#endif // Q_OS_IOS
